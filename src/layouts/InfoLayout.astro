---
import RootLayout from "./RootLayout.astro";
import Footer from "../components/footer.astro";
import WarpBackground from "../components/warp-background";

const { title, description } = Astro.props;

const pathname = Astro.url.pathname;
---

<RootLayout title={title} description={description}>
	<div class="flex relative gap-4 w-full">
		<nav class="relative w-4 md:min-w-2xs md:min-h-screen md:ml-4 md:pb-4">
			<div class="w-full h-full max-md:w-4 md:max-w-2xs fixed -z-10 md:bottom-4 md:rounded-b-full overflow-hidden">
				<WarpBackground
					color1="#ffffff"
					color2="#27272a"
					color3="#52525b"
					speed={0.15}
					swirl={1.5}
					swirlIterations={10}
					shapeScale={0.3}
					client:load
				/>
			</div>
		</nav>

		<main class="relative flex-1 min-w-0">
			<slot />
			<Footer />
		</main>


	</div>
</RootLayout>
