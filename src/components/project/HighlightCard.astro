---
const { value, label } = Astro.props;
---
<div class="highlight-card border border-zinc-700/60 rounded-lg text-center">
  <span class:list={['value font-bold tracking-tight bg-gradient-to-b from-white to-zinc-400 bg-clip-text text-transparent', { 'long-value': [...value].length > 5 }]}>{value}</span>
  <span class="label text-zinc-400">{label}</span>
</div>

<style>
  .highlight-card {
    container-type: inline-size;
    min-width: 0;
    height: 9rem;
    padding: 0.75rem;
    display: grid;
    grid-template-rows: 2.75rem 3.25rem;
    gap: 0.5rem;
    align-items: center;
    align-content: center;
  }
  .value {
    font-size: clamp(0.75rem, 30cqw, 2.25rem);
    line-height: 1.1;
    white-space: nowrap;
  }
  .long-value { font-size: clamp(0.75rem, 18cqw, 1.75rem); }
  .label {
    font-size: clamp(0.625rem, 12cqw, 0.75rem);
    line-height: 1.35;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }
</style>
