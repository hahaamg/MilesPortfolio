---
const { value, label } = Astro.props;
---
<div class="highlight-card border border-zinc-700/60 rounded-lg text-center">
  <span class="value font-bold tracking-tight bg-gradient-to-b from-white to-zinc-400 bg-clip-text text-transparent">{value}</span>
  <span class="label text-zinc-400">{label}</span>
</div>

<style>
  .highlight-card {
    container-type: inline-size;
    min-width: 0;
    height: 9rem;
    padding: 0.75rem;
    display: grid;
    grid-template-rows: auto auto;
    row-gap: 0.5rem;
    /* Centre the pair as a block, so the leftover height splits evenly
       above and below the text instead of pooling at one end. */
    align-content: center;
    justify-items: center;
  }
  .value {
    /* One size for every card on the site, so the component looks the same
       from project to project. The script below only overrides --value-fs
       for a row whose widest value would not fit at this size. */
    font-size: var(--value-fs, clamp(1.5rem, 26cqw, 2.25rem));
    line-height: 1.1;
    white-space: nowrap;
  }
  .label {
    font-size: clamp(0.625rem, 12cqw, 0.75rem);
    line-height: 1.35;
    overflow-wrap: anywhere;
    text-wrap: balance;
    /* Reserve the tallest label in this grid row (set by the script), so a
       card whose label wraps to fewer lines keeps the same block height and
       stays aligned with its neighbours. */
    height: calc(var(--label-rows, 2) * 1.35em);
    align-self: start;
  }
</style>

<script>
  // Cards share one size from CSS so the component reads the same on every
  // project page. This only measures whether the widest value in a row still
  // fits; if it does not, the whole row steps down together, which keeps the
  // three baselines aligned. It also reserves the tallest label in the row.
  const REF = 100;      // px, measurement reference
  const MIN = 14;       // px, 0.875rem — floor for an unusually long value

  function fitRow(row: HTMLElement) {
    const cards = Array.from(
      row.querySelectorAll<HTMLElement>('.highlight-card'),
    );
    if (!cards.length) return;

    // The CSS base size applies everywhere; only step in when the widest
    // value in this row would spill out of its card, so one long value does
    // not shrink the cards on every other page.
    row.style.removeProperty('--value-fs');
    const base = parseFloat(
      getComputedStyle(cards[0].querySelector('.value') as HTMLElement).fontSize,
    );

    let size = base;
    for (const card of cards) {
      const value = card.querySelector<HTMLElement>('.value');
      if (!value) continue;
      const avail = card.clientWidth
        - parseFloat(getComputedStyle(card).paddingLeft)
        - parseFloat(getComputedStyle(card).paddingRight);
      if (avail <= 0) continue;

      const prev = value.style.fontSize;
      value.style.fontSize = `${REF}px`;
      const width = value.getBoundingClientRect().width;
      value.style.fontSize = prev;
      if (!width) continue;

      size = Math.min(size, (avail / width) * REF);
    }

    if (size < base - 0.5) {
      row.style.setProperty('--value-fs', `${Math.max(MIN, size).toFixed(2)}px`);
    }

    // Reserve the tallest label in the row, so cards with fewer label lines
    // keep the same block height and stay aligned.
    let lines = 1;
    for (const card of cards) {
      const label = card.querySelector<HTMLElement>('.label');
      if (!label) continue;
      const prev = label.style.height;
      label.style.height = 'auto';
      const lh = parseFloat(getComputedStyle(label).lineHeight);
      const n = lh > 0 ? Math.round(label.scrollHeight / lh) : 1;
      label.style.height = prev;
      lines = Math.max(lines, n);
    }
    row.style.setProperty('--label-rows', String(lines));
  }

  function fitAll() {
    const rows = new Set<HTMLElement>();
    document.querySelectorAll<HTMLElement>('.highlight-card').forEach((card) => {
      if (card.parentElement) rows.add(card.parentElement);
    });
    rows.forEach(fitRow);
  }

  const run = () => requestAnimationFrame(fitAll);
  run();
  addEventListener('resize', run);
  document.addEventListener('astro:page-load', run);
  if (document.fonts?.ready) document.fonts.ready.then(run);
</script>
