---
const { label = 'Contents' } = Astro.props;
---

<nav
  class="project-toc group hidden xl:flex fixed top-1/2 right-0 z-20 -translate-y-1/2 flex-col justify-center pr-6 pl-16 py-6 max-h-[80dvh]"
  aria-label={label}
  data-project-toc
>
  <div class="toc-panel relative rounded-lg px-4 py-3">
    <ul class="relative flex flex-col items-end gap-3" data-toc-list></ul>
  </div>
</nav>

<style is:global>
  /* Stay hidden until the script finds headings, so a page without
     SectionTitles never shows an empty rail. */
  .project-toc:not([data-ready]) {
    display: none;
  }

  /* The panel is invisible while collapsed and fades in on hover, so the
     expanded labels sit on their own surface instead of over body text. */
  .project-toc .toc-panel {
    background: rgba(24, 24, 27, 0);
    border: 1px solid transparent;
    box-shadow: 0 0 0 0 rgba(0, 0, 0, 0);
    transition:
      background-color 250ms ease,
      border-color 250ms ease,
      box-shadow 250ms ease;
  }

  .project-toc:hover .toc-panel,
  .project-toc:focus-within .toc-panel {
    background: rgba(24, 24, 27, 0.92);
    border-color: #27272a;
    box-shadow: 0 8px 24px -8px rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(8px);
  }

  /* Collapsed: only the dash is visible. Expanded on hover: the dash shrinks
     to a short marker and the label fades in beside it. */
  .project-toc .toc-dash {
    display: block;
    height: 1px;
    background: #52525b;
    transition:
      width 300ms cubic-bezier(0.4, 0, 0.2, 1),
      background-color 200ms ease;
  }

  .project-toc .toc-label {
    max-width: 0;
    opacity: 0;
    overflow: hidden;
    white-space: nowrap;
    transition:
      max-width 300ms cubic-bezier(0.4, 0, 0.2, 1),
      opacity 200ms ease;
  }

  .project-toc:hover .toc-dash,
  .project-toc:focus-within .toc-dash {
    width: 0.5rem !important;
  }

  .project-toc:hover .toc-label,
  .project-toc:focus-within .toc-label {
    max-width: 14rem;
    opacity: 1;
  }

  /* The active section reads darker and thicker, both collapsed and expanded. */
  .project-toc .toc-item[data-active] .toc-dash {
    height: 2px;
    background: #e4e4e7;
  }

  .project-toc .toc-item[data-active] .toc-label {
    color: #f4f4f5;
  }

  .project-toc a:hover .toc-dash {
    background: #d4d4d8;
  }

  .project-toc a:hover .toc-label {
    color: #f4f4f5;
  }

  @media (prefers-reduced-motion: reduce) {
    .project-toc .toc-dash,
    .project-toc .toc-label {
      transition-duration: 1ms;
    }
  }
</style>

<script>
  function initTableOfContents() {
    const toc = document.querySelector<HTMLElement>('[data-project-toc]');
    const list = toc?.querySelector<HTMLUListElement>('[data-toc-list]');
    if (!toc || !list) return;

    const headings = Array.from(
      document.querySelectorAll<HTMLHeadingElement>('main h2[data-section-title]')
    );

    list.replaceChildren();

    if (headings.length < 2) {
      toc.removeAttribute('data-ready');
      return;
    }

    // Dash width tracks title length, so the collapsed rail mirrors the
    // shape of the document rather than showing uniform ticks.
    const lengths = headings.map((h) => (h.dataset.sectionTitle ?? '').length);
    const minLen = Math.min(...lengths);
    const maxLen = Math.max(...lengths);
    const MIN_W = 16;
    const MAX_W = 40;

    function dashWidth(len: number): number {
      if (maxLen === minLen) return (MIN_W + MAX_W) / 2;
      const ratio = (len - minLen) / (maxLen - minLen);
      return Math.round(MIN_W + ratio * (MAX_W - MIN_W));
    }

    const items = new Map<string, HTMLLIElement>();

    headings.forEach((heading, index) => {
      if (!heading.id) return;

      const title = heading.dataset.sectionTitle ?? heading.textContent ?? '';

      const item = document.createElement('li');
      item.className = 'toc-item w-full';

      const link = document.createElement('a');
      link.href = `#${heading.id}`;
      link.className = 'flex items-center justify-end gap-3 py-1 cursor-pointer';

      const labelEl = document.createElement('span');
      labelEl.className = 'toc-label text-sm leading-none text-zinc-400';
      labelEl.textContent = title;

      const dash = document.createElement('span');
      dash.className = 'toc-dash shrink-0';
      dash.style.width = `${dashWidth(lengths[index])}px`;

      link.append(labelEl, dash);
      item.appendChild(link);
      list.appendChild(item);
      items.set(heading.id, item);
    });

    if (items.size === 0) {
      toc.removeAttribute('data-ready');
      return;
    }

    toc.setAttribute('data-ready', '');

    let currentId = '';
    function setActive(id: string) {
      if (id === currentId) return;
      currentId = id;
      for (const [headingId, item] of items) {
        if (headingId === id) item.setAttribute('data-active', '');
        else item.removeAttribute('data-active');
      }
    }

    const visible = new Set<string>();
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const id = (entry.target as HTMLElement).id;
          if (entry.isIntersecting) visible.add(id);
          else visible.delete(id);
        }

        const ordered = headings.filter((h) => visible.has(h.id));
        if (ordered.length > 0) {
          setActive(ordered[0].id);
          return;
        }

        // Mid-section: keep the last heading scrolled past highlighted.
        let last = headings[0];
        for (const heading of headings) {
          if (heading.getBoundingClientRect().top <= 120) last = heading;
        }
        if (last) setActive(last.id);
      },
      { rootMargin: '-80px 0px -70% 0px', threshold: 0 }
    );

    for (const heading of headings) observer.observe(heading);

    document.addEventListener(
      'astro:before-swap',
      () => {
        observer.disconnect();
      },
      { once: true }
    );
  }

  initTableOfContents();
  document.addEventListener('astro:page-load', initTableOfContents);
</script>
