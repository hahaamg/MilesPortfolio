---
import H1 from "../../components/h1.astro";
import InfoLayout from "../../layouts/InfoLayout.astro";
import ProjectList from "../../components/ProjectList";
import { enProjects, enCategories } from "../../data/projectsData";
---

<InfoLayout title="Projects | Miles Sun" description="Explore my recent work in product planning, AI & software engineering, and user research & growth.">
  <div class="p-4 sm:pt-8 sm:px-12 pb-20 min-h-dvh">
    <H1> Projects </H1>
    {/* @ts-expect-error React component in Astro */}
    <ProjectList client:load projects={enProjects} categories={enCategories} allCategory="All" locale="en" />
  </div>
</InfoLayout>
